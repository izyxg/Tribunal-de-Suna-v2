{
  "cleanUrls": false,
  "redirects": [
    { "source": "/invite/:token", "destination": "/?invite=:token", "permanent": false },
    { "source": "/i/:token", "destination": "/?invite=:token", "permanent": false }
  ],
  "rewrites": [
    { "source": "/invite/:token", "destination": "/index.html" },
    { "source": "/i/:token", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
